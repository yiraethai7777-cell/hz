DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
KAKAO_AUTH_PATH=./auth.json
KAKAO_DEBUG=1

# Web/API uses the existing Railway PORT and DATABASE_URL
GL_WEB_ENABLED=1
GL_ADMIN_USERNAME=admin
# Generate these locally with: node scripts/admin-setup.js
GL_ADMIN_PASSWORD_HASH=
GL_SESSION_SECRET=
# Optional invite URL, https://open.kakao.com/...
GL_OPENCHAT_URL=
# NEXI VALORANT lookup (HenrikDev API key; keep secret, never commit an actual key)
HENRIKDEV_API_KEY=
# Comma-separated Riot IDs with independently verified sharing consent.
# Example: VALORANT_APPROVED_PLAYERS=Name#KR1,Another Name#KR1
# Riot Sign On (RSO) verification is not automated by this bot.
VALORANT_APPROVED_PLAYERS=
